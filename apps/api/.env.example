# Copy to .env for local development. Nothing here is inlined into a
# client bundle, so real secrets are fine — but keep .env out of git.

# Supabase instance whose JWTs this server trusts. Local: `supabase start`.
# A physical device needs the Tailscale/LAN address, same as the app.
SUPABASE_URL=http://localhost:55321

# Gemini key for the chat route. Get one from https://aistudio.google.com.
# On Fly: `fly secrets set GOOGLE_GENERATIVE_AI_API_KEY=... --app magpie-api`.
GOOGLE_GENERATIVE_AI_API_KEY=

# Direct Jev meal recommendations through the AI SDK (no Vercel account needed).
# Without this key, cookbook browsing and the rest of the API still work.
TYPESAFE_AI_API_KEY=

# Postgres connection string. Local: `supabase status` → DB URL (port 55322).
# Use the direct postgres URL, not the pooler. On Fly: `fly secrets set DATABASE_URL=...`.
DATABASE_URL=postgresql://postgres:postgres@localhost:55322/postgres

# Port to listen on. Not 8080 — the PowerSync container has that one.
# Fly sets this itself, to match internal_port in fly.toml.
PORT=8787

# Invite landing page installation buttons. HTTPS App Store, Play Store,
# TestFlight, or distribution links. Omit while no distribution is available.
MAGPIE_IOS_INSTALL_URL=
MAGPIE_ANDROID_INSTALL_URL=

# Recipe art (ADR 38). Without both, recipes keep their gradient.
# The matting service: `pnpm art:matting` locally, on Fly the Flycast address.
ART_MATTING_URL=http://localhost:8790
# Uploads art to the recipe-art bucket. Local: `pnpm supabase status`.
# On Fly: `fly secrets set SUPABASE_SERVICE_ROLE_KEY=... --app magpie-api`.
SUPABASE_SERVICE_ROLE_KEY=
