{
  "name": "magpie",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "ios:prebuild": "pnpm --filter mobile exec expo prebuild --clean -p ios",
    "android:prebuild": "pnpm --filter mobile exec expo prebuild --clean -p android",
    "api": "pnpm --filter api dev",
    "api:deploy": "fly deploy --config apps/api/fly.toml --dockerfile apps/api/Dockerfile",
    "stack:up": "supabase start && docker compose up -d",
    "stack:down": "docker compose down && supabase stop",
    "stack:logs": "docker compose logs -f powersync",
    "stack:status": "supabase status && docker compose ps",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/db/database.types.ts",
    "sync:reload": "docker compose restart powersync",
    "fn:serve": "supabase functions serve",
    "fn:deploy": "supabase functions deploy",
    "assets:optimize": "node scripts/optimize-onboarding-art.mjs",
    "assets:slice": "node scripts/slice-spritesheet.mjs",
    "assets:test": "node --test scripts/optimize-onboarding-art.test.mjs",
    "assets:matting:test": "node --test scripts/chroma-key.test.mjs",
    "assets:slice:test": "node --test scripts/slice-spritesheet.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write . && deno fmt --config supabase/functions/deno.json supabase/functions",
    "format:check": "prettier --check . && deno fmt --check --config supabase/functions/deno.json supabase/functions"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@op-engineering/op-sqlite",
      "esbuild",
      "sharp",
      "supabase"
    ],
    "patchedDependencies": {
      "react-native-screens@4.30.0": "patches/react-native-screens@4.30.0.patch"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^2.115.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "expo": "~58.0.16",
    "react": "19.3.0",
    "react-native": "0.88.0"
  }
}
